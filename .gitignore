# Data: raw PubMed abstracts are not redistributed; derived artifacts are regenerated by the scripts
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Fitted models (regenerated by src/02 and src/03)
models/*
!models/.gitkeep

# Prediction files contain abstract text, so keep them out of the repo
results/*_test_predictions.csv

# Python / OS
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
.venv*/
venv*/
.env
